# Copy to .env and fill in real values: `cp .env.example .env`.
#
# docker-compose.yml reads these through ${VAR:?} interpolation, so an unset or empty
# variable stops Compose before a container is created and names the variable it wanted —
# rather than starting the stack with a placeholder password. .env is git-ignored; this
# file is the committed record of what has to be in it.
#
# Generate the two secrets rather than inventing them:
#
#   POSTGRES_PASSWORD   openssl rand -base64 30 | tr -dc 'A-Za-z0-9' | head -c 40
#   JWT_SECRET          openssl rand -hex 32
#
# Or, with no OpenSSL on the box (Node ships with this repo):
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Keep both alphanumeric. Compose reads `$` in this file as interpolation and `#` as the
# start of a comment, and these values are also pasted into psql and shell commands.
#
# Notes on changing them later:
#   - POSTGRES_* is consumed by initdb, which runs once against an empty volume. Editing
#     POSTGRES_PASSWORD does not change the password of a database that already exists;
#     `make db-password` applies it to the running one.
#   - JWT_SECRET is read at backend startup. Changing it invalidates every issued token,
#     which logs everyone out. An unset one is fatal at startup by design — an empty HS256
#     key signs and verifies happily, so every token would be forgeable.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=alexithymia

JWT_SECRET=

# Host loopback port for container Nginx — the host Nginx reverse proxy forwards to this port.
FRONTEND_PORT=8082

# Host loopback port for the backend Go service (127.0.0.1:8081). Local `curl` debugging only.
BACKEND_DEBUG_PORT=8081

# Production Domain Architecture (for reference & build arguments):
# WebApp:      https://alexithymialovequantifier.voglerprojekte.com
# Backend API: https://api.alexithymialovequantifier.voglerprojekte.com
# Android default: VITE_ANDROID_API_URL=https://api.alexithymialovequantifier.voglerprojekte.com
