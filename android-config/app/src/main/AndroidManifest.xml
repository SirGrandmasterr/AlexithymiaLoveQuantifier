<?xml version="1.0" encoding="utf-8"?>
<!--
  Capacitor 8's generated manifest, plus the network and privacy configuration this app needs.

  Verbatim from node_modules/@capacitor/cli/assets/android-template.tar.gz except for the
  six annotated changes below. See android-config/README.md for how to re-sync it after a
  Capacitor upgrade — this is a whole-file replacement, so a new template's additions would
  otherwise be silently dropped.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">
        <!--
          CHANGE 1 — allowBackup="false" (template: true).

          The session token and the offline copy of every relationship live in WebView
          localStorage, inside the app's private data directory. With backup enabled, Android
          replicates that directory to Google Drive under the user's account. For an app whose
          Vault page tells people their data stays on their own server, copying it to a third
          party by default is a promise broken in the manifest.

          Since Phase 6 the same directory also holds the journal's per-device settings
          (which questions are asked, whether voice is on, the pinned tier), the journal's
          outbox once it exists, and the speech model's weight files under files/models/.
          None of that is the user's words — those are on the server, and the audio is never
          written anywhere — but the settings say what the user asked this device to do, and
          the model files are re-fetched from the configured server rather than restored
          from a copy nobody verified.

          CHANGE 2 and 3 — networkSecurityConfig and usesCleartextTraffic.

          Both point at the same decision, documented in res/xml/network_security_config.xml:
          this app talks to a server the user runs at an address the user types, which on a LAN
          has no certificate and cannot get one. The config file is authoritative wherever both
          apply; the older flag is kept for libraries that read it directly.
        -->

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              CHANGE 6 — the launcher's static app shortcut (Phase 6, slice 6-F).

              One long-press on the home-screen icon offers *Check in*, which opens the
              journal with the composer already up. The shortcut itself is
              res/xml/shortcuts.xml, which carries the reasoning; this line is what makes the
              launcher read it, and it has to sit on the activity that owns the MAIN/LAUNCHER
              filter or no launcher will look for it.

              Deliberately absent beside it: an <intent-filter> for the shortcut's URL. The
              shortcut's intent is explicit — it names this package and this class — so it is
              delivered without one, and adding a filter would publish the scheme to every
              other app and every browser on the device in exchange for nothing.

              Also deliberately absent: any <service> or <receiver> of this app's own. The
              nightly reminder is an AlarmManager alarm owned by the local-notifications
              plugin, and there is no background component in this app at all — no widget, no
              foreground service, nothing that runs when the app is not open.
            -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      CHANGE 4 — POST_NOTIFICATIONS, for the check-in cadence reminders and, since Phase 6,
      the journal's nightly ritual reminder.

      Required from API 33; below that the runtime request resolves as already-granted and the
      code path is identical. It is requested when the user turns reminders on in Profile, not
      at launch: a permission prompt before the user has seen what it is for is the reliable
      way to get it denied permanently. The ritual's reminder follows the same policy from the
      same screen — the request is made when the nightly questions are switched on, and a
      refusal costs the reminder and not the feature, because the ritual is a screen.

      Two channels, one permission, and one notification each: the cadence reminder is one per
      relationship with a rhythm, at 10:00, and the ritual reminder is exactly one, at the hour
      the user chose. Neither ever carries a badge count, and neither cancels the other's
      pending notifications (src/mobile/ritualReminder.js says how).

      Deliberately still absent: CAMERA and READ_MEDIA_IMAGES. Avatar upload goes through the
      system photo picker, which returns one user-chosen file and needs no storage permission
      on any API level. Adding one would widen access from "the picture they picked" to "every
      photo on the device" in exchange for nothing.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      CHANGE 5 — RECORD_AUDIO, for the journal's voice check-ins (Phase 6, slice 6-C).

      A runtime permission on every supported API level. It is requested at the first tap of
      the microphone button and never at launch, for the same reason POST_NOTIFICATIONS is
      requested when reminders are turned on: a permission prompt before the user has seen
      what it is for is the reliable way to get it denied permanently. The request lives in
      one place — the recorder's `requestStream`, through the journal plugin's
      checkPermissions/requestPermissions — and the plugin's startCapture refuses to open
      the device without the grant, so no code path can record without having asked. A
      denial is not an error: the check-in falls through to typing and chips.

      Deliberately absent: FOREGROUND_SERVICE and FOREGROUND_SERVICE_MICROPHONE. There is
      no background capture to need them. Recording happens only while the button is lit,
      stops on a tap, on two seconds of silence or at thirty seconds, and the plugin aborts
      it the moment the activity pauses. A foreground service would let the microphone stay
      open with the app hidden, which is exactly the claim the Vault page's "Does it listen?"
      answer says this app never makes.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
</manifest>
